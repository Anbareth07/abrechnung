# --- Deployment (docker-compose.yml auf dem Raspberry Pi) -----------------------

# Gleiche Origin: nginx leitet /api an das Backend weiter (kein CORS/Private-Network).
VITE_API_URL=/api

# --- Datenbank ------------------------------------------------------------------
# Das Backend läuft auf dem Pi mit SQLite (kein DB-Container; Datei liegt im
# Docker-Volume "abrechnung-data"). Die URL ist fest in docker-compose.yml gesetzt.
# Für lokale Entwicklung stattdessen:
#   Postgres (Default): DATABASE_URL=postgresql+psycopg://abrechnung:abrechnung@localhost:5432/abrechnung
#   SQLite:             DATABASE_URL=sqlite:///./dev.db
